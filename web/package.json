{
  "name": "drop-the-number-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:runtime": "node ../scripts/prepare-web.mjs",
    "dev": "npm run prepare:runtime && vite --host 127.0.0.1",
